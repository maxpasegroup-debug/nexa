generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(BDM)
  active            Boolean   @default(true)
  status            String    @default("ACTIVE")
  theme             String    @default("dark")
  isLegacyIceconnect Boolean  @default(false)
  lastLoginAt       DateTime?
  isActive          Boolean   @default(true)
  phone             String?
  joinedAt          DateTime?
  archivedAt        DateTime?
  deletedAt         DateTime?
  purgeAfter        DateTime?
  defaultPassword   Boolean   @default(false)
  employeeCode      String?   @unique @default(cuid())
  bdmSubType        String    @default("BDM")
  bdmCode           String?
  businessId        String?
  business          Business? @relation(fields: [businessId], references: [id])
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  leads             Lead[]
  createdLeads      Lead[]    @relation("LeadCreator")
  tasks             Task[]
  onboarding        OnboardingSession?
  activityLogs      ActivityLog[]
  leadActivities    LeadActivity[]
  reminders         Reminder[]
  dailyBriefs       DailyBrief[]
  callLogs          CallLog[]
  targets           Target[]
  emailAccounts     EmailAccount[]
  bugsReported      Bug[]        @relation("BugReporter")
  bugsAssigned      Bug[]        @relation("BugAssignee")
  escalationsRaised Escalation[] @relation("EscalationRaiser")
  escalationsResolved Escalation[] @relation("EscalationResolver")
  passwordResets    PasswordResetRequest[] @relation("UserPasswordResets")
  resetRequestsMade PasswordResetRequest[] @relation("ResetRequester")
  bdeCommissions    Commission[]       @relation("BDECommissions")
  slabAchievements  SlabAchievement[]
  customerPortfolio CustomerPortfolio[]
  payoutHistory     PayoutHistory[]
  bdmOnboardingLeads OnboardingLead[] @relation("BDMOnboardingLeads")
  bdmBusinesses     Business[] @relation("BusinessBDM")
  sdeOnboardingLeads OnboardingLead[] @relation("SDEOnboardingLeads")
  bdmOnboardingSessions OnboardingSession[] @relation("BDMSessions")
  sdeOnboardingSessions OnboardingSession[] @relation("SDESessions")
  wallet            BDMWallet?
  clarificationsRaised OnboardingClarification[] @relation("ClarificationRaiser")
  clarificationsAnswered OnboardingClarification[] @relation("ClarificationAnswerer")
  workspaceTemplates WorkspaceTemplate[]
  workspacesBuilt    WorkspaceConfig[]
  accounts          Account[]
  sessions          Session[]
  sdeInstallations  AgentInstallation[] @relation("SDEInstallations")
  leadNotes         LeadNote[]    @relation("NoteAuthor")
  bdmAnalysis       NexaBDMAnalysis?
  agentOnboardingSessions AgentOnboardingSession[] @relation("AgentOnboardingBDM")
  bossLocksCreated  BossWorkLock[] @relation("BossLockCreator")
  bossLocksFinished BossWorkLock[] @relation("BossLockFinisher")
  career7GrowthBoardAgents Career7GrowthBoardAgent[]
  career7CreditWallets Career7CreditWallet[]
  career7CreditLedger Career7CreditLedger[]
  bgosPaymentIntents BgosPaymentIntent[]
  bgosPaymentTransactions BgosPaymentTransaction[]
  blizzwayOnboardingProfiles BlizzwayOnboardingProfile[]
  blizzwayBdpProfiles BlizzwayBdpProfile[]
  blizzwayStarterPathways BlizzwayStarterPathway[]
  blizzwayCompanionActivations BlizzwayCompanionActivation[]
  blizzwayCompanionRuns BlizzwayCompanionRun[]
  blizzwayCompanionRequests BlizzwayCompanionRequest[]
  blizzwayUserQuests BlizzwayUserQuest[]
  blizzwayUserAchievements BlizzwayUserAchievement[]
  blizzwayXpEvents BlizzwayXpEvent[]
  blizzwayPathwayStreaks BlizzwayPathwayStreak[]
  blizzwayPathwayLevelProgress BlizzwayPathwayLevelProgress[]

  @@index([email])
  @@index([role])
  @@index([businessId])
}

enum Role {
  OWNER
  BOSS
  BDM
  SDE
  ADMIN
  EMPLOYEE
}

enum UserRole {
  OWNER
  BDM
  SDE
  BOSS
  EMPLOYEE
  ADMIN
}

enum BusinessStatus {
  LEAD
  ONBOARDING
  BUILDING
  PREVIEW
  TRIAL
  ACTIVE
  RENEWAL_FAILED
  SUSPENDED
  OFFBOARDED
}

model PasswordResetRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserPasswordResets", fields: [userId], references: [id])
  requestedBy String
  requester   User     @relation("ResetRequester", fields: [requestedBy], references: [id])
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id           String   @id @default(cuid())
  clientId     String?  @unique
  name         String
  type         String
  teamSize     String
  goal         String
  plan         String   @default("STARTER")
  healthScore  Int      @default(50)
  status       BusinessStatus @default(LEAD)
  statusUpdatedAt DateTime?
  trialStartedAt DateTime?
  trialEndsAt DateTime?
  firstPaymentAt DateTime?
  lastPaymentAt DateTime?
  nextBillingDate DateTime?
  gracePeriodEndsAt DateTime?
  suspendedAt DateTime?
  offboardedAt DateTime?
  razorpayCustomerId String?
  razorpaySubscriptionId String?
  razorpayMandateId String?
  churnRiskAlertedAt DateTime?
  renewalFailedAt DateTime?
  bdmNotifiedAt DateTime?
  bossEscalatedAt DateTime?
  dataPreservedUntil DateTime?
  bdmId        String?
  bdm          User?    @relation("BusinessBDM", fields: [bdmId], references: [id])
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  leads        Lead[]
  invites      TeamInvite[]
  activityLogs ActivityLog[]
  sprints      Sprint[]
  bugs         Bug[]
  escalations  Escalation[]
  integrationHealth IntegrationHealth[]
  nexaMemory       NexaMemory[]
  nexaSchedules    NexaSchedule[]
  snapshots        BusinessSnapshot[]
  nexaActions      NexaAction[]
  emailAccounts    EmailAccount[]
  emails           Email[]
  emailTemplates   EmailTemplate[]
  commissions      Commission[]
  onboardingLead   OnboardingLead?
  trialSubscription TrialSubscription?
  pipelines        Pipeline[]
  agentInstallations AgentInstallation[]
  agentOnboardingSessions AgentOnboardingSession[]
  career7GrowthBoardAgents Career7GrowthBoardAgent[]
  career7CreditWallets Career7CreditWallet[]
  career7CreditLedger Career7CreditLedger[]
  paymentConfigs BusinessPaymentConfig[]
  bgosPaymentIntents BgosPaymentIntent[]
  bgosPaymentTransactions BgosPaymentTransaction[]
  bgosInvoicePlaceholders BgosInvoicePlaceholder[]
  blizzwayOnboardingProfiles BlizzwayOnboardingProfile[]
  blizzwayBdpProfiles BlizzwayBdpProfile[]
  blizzwayStarterPathways BlizzwayStarterPathway[]
  blizzwayCompanionActivations BlizzwayCompanionActivation[]
  blizzwayCompanionRuns BlizzwayCompanionRun[]
  blizzwayCompanionRequests BlizzwayCompanionRequest[]
  blizzwayUserQuests BlizzwayUserQuest[]
  blizzwayUserAchievements BlizzwayUserAchievement[]
  blizzwayXpEvents BlizzwayXpEvent[]
  blizzwayPathwayStreaks BlizzwayPathwayStreak[]
  blizzwayPathwayLevelProgress BlizzwayPathwayLevelProgress[]
  dataExports    CustomerDataExport[]
}

enum PaymentGatewayProvider {
  RAZORPAY
  STRIPE
  PAYPAL
  CASHFREE
  MANUAL
}

enum BgosPaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum BgosPaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model BusinessPaymentConfig {
  id                 String                   @id @default(cuid())
  businessModel      String
  businessId         String?
  business           Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabledGateways    PaymentGatewayProvider[] @default([MANUAL])
  defaultGateway     PaymentGatewayProvider   @default(MANUAL)
  currency           String                   @default("INR")
  credentials        Json                     @default("{}")
  config             Json                     @default("{}")
  successCallback    String
  failureCallback    String
  creditTopUpMapping Json                     @default("{}")
  paymentIntents     BgosPaymentIntent[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([businessModel, businessId])
  @@index([businessModel])
  @@index([businessId])
}

model BgosPaymentIntent {
  id                String                 @id @default(cuid())
  businessModel     String
  businessId        String
  business          Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  configId          String?
  config            BusinessPaymentConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  gateway           PaymentGatewayProvider
  status            BgosPaymentStatus      @default(CREATED)
  currency          String
  amount            Int
  credits           Int?
  description       String
  providerOrderId   String?
  providerPaymentId String?
  idempotencyKey    String?
  successCallback   String
  failureCallback   String
  metadata          Json                   @default("{}")
  transactions      BgosPaymentTransaction[]
  invoices          BgosInvoicePlaceholder[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  completedAt       DateTime?

  @@unique([idempotencyKey])
  @@index([businessModel, businessId, userId])
  @@index([gateway, status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@index([createdAt])
}

model BgosPaymentTransaction {
  id                String                       @id @default(cuid())
  paymentIntentId   String
  paymentIntent     BgosPaymentIntent            @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  businessModel     String
  businessId        String
  business          Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId            String
  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway           PaymentGatewayProvider
  status            BgosPaymentTransactionStatus @default(PENDING)
  amount            Int
  currency          String
  providerOrderId   String?
  providerPaymentId String?
  idempotencyKey    String
  metadata          Json                         @default("{}")
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([idempotencyKey])
  @@index([paymentIntentId])
  @@index([businessModel, businessId, userId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}

model BgosInvoicePlaceholder {
  id              String            @id @default(cuid())
  businessModel   String
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  paymentIntentId String?
  paymentIntent   BgosPaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  invoiceNumber   String            @unique
  amount          Int
  currency        String            @default("INR")
  status          String            @default("PLACEHOLDER")
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now())

  @@index([businessModel, businessId, userId])
  @@index([paymentIntentId])
}

model WebhookLog {
  id        String   @id @default(cuid())
  source    String
  event     String
  payload   Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())
}

model CustomerDataExport {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reason      String?
  payload     Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model MarketplaceAgent {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  tagline         String
  description     String   @db.Text
  category        AgentCategory
  type            AgentType @default(BACKGROUND) @map("agentType")
  career7Type     Career7AgentType?
  creditPrice     Int      @default(0)
  icon            String
  career7Status   Career7MarketplaceStatus @default(ACTIVE)
  colorPrimary    String
  colorSecondary  String
  gradient        String
  onboardingFee   Float
  monthlyFee      Float
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  isPrebuilt      Boolean  @default(false)
  isRequestable   Boolean  @default(true)
  canAddToGrowthBoard Boolean @default(false)
  sortOrder       Int      @default(0)
  businessModel   String   @default("blizzway")
  businessId      String?
  companionCategory String?
  shortDescription String?
  longDescription String?
  pricingMode     String   @default("credits")
  isTrending      Boolean  @default(false)
  capabilities    Json     @default("[]")
  expectedOutput  Json     @default("[]")
  recommendedFor  Json     @default("[]")
  requiredInputs  Json     @default("[]")
  chargeOn        String   @default("run")
  features        Json     @default("[]")
  benefits        Json     @default("[]")
  howItWorks      Json     @default("[]")
  stats           Json     @default("{}")
  metaTitle       String?
  metaDesc        String?
  installations   AgentInstallation[]
  offers          AgentOffer[]
  notifyRequests  AgentNotifyRequest[]
  career7GrowthBoardAgents Career7GrowthBoardAgent[]
  blizzwayCompanionActivations BlizzwayCompanionActivation[]
  blizzwayCompanionRuns BlizzwayCompanionRun[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([career7Type])
  @@index([career7Status])
  @@index([canAddToGrowthBoard])
  @@index([businessModel, businessId])
  @@index([companionCategory])
}

enum AgentCategory {
  UNIVERSAL
  HEALTHCARE
  EDUCATION
  REAL_ESTATE
  CONSTRUCTION
  RETAIL
  FINANCE
}

enum AgentType {
  UI
  BACKGROUND
}

enum Career7AgentType {
  LEARNING
  EARNING
  CAREER
  MIGRATION
  LANGUAGE
  EXAM
  FINANCE
  BLIZZWAY
}

enum Career7MarketplaceStatus {
  DRAFT
  ACTIVE
  COMING_SOON
  ARCHIVED
}

enum Career7GrowthBoardPath {
  LEARNING
  EARNING
}

enum Career7GrowthBoardAgentStatus {
  ACTIVE
  INACTIVE
}

model Career7GrowthBoardAgent {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId       String
  agent         MarketplaceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  path          Career7GrowthBoardPath
  status        Career7GrowthBoardAgentStatus @default(ACTIVE)
  addedAt       DateTime @default(now())
  deactivatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, userId, agentId, path])
  @@index([businessId, userId, path, status])
  @@index([agentId])
}

enum Career7CreditLedgerType {
  TOP_UP
  USAGE
  ADJUSTMENT
  REWARD
  MONTHLY_GRANT
}

model BlizzwayCreditPackage {
  id            String   @id @default(cuid())
  businessModel String   @default("blizzway")
  slug          String
  name          String
  description   String
  priceInr      Int
  baseCredits   Int
  bonusCredits  Int      @default(0)
  totalCredits  Int
  badgeLabel    String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessModel, slug])
  @@index([businessModel, active, sortOrder])
}

model BlizzwaySubscriptionPlan {
  id             String   @id @default(cuid())
  businessModel  String   @default("blizzway")
  slug           String
  name           String
  monthlyPriceInr Int
  monthlyCredits Int
  features       Json     @default("[]")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([businessModel, slug])
  @@index([businessModel, active, sortOrder])
}

model BlizzwayOnboardingProfile {
  id                   String   @id @default(cuid())
  businessModel        String   @default("blizzway")
  businessId           String
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStatus        String
  dreamGoal            String
  preferredLocation    String?
  educationLevel       String?
  skills               Json     @default("[]")
  interests            Json     @default("[]")
  confidenceLevel      String?
  communicationLevel   String?
  financialReadiness   String?
  timeline             String?
  languageGoals        Json     @default("[]")
  admissionsGoals      Json     @default("[]")
  earningGoals         Json     @default("[]")
  answers              Json     @default("{}")
  completionStatus     String   @default("IN_PROGRESS")
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([businessModel, businessId, userId])
  @@index([businessModel, businessId])
}

model BlizzwayBdpProfile {
  id                 String   @id @default(cuid())
  businessModel      String   @default("blizzway")
  businessId         String
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline           String
  currentStageSummary String  @db.Text
  strengths          Json     @default("[]")
  readiness          Json     @default("{}")
  recommendedActions Json     @default("[]")
  profileStrength    Int      @default(35)
  source             String   @default("nexa_onboarding_v1")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([businessModel, businessId, userId])
  @@index([businessModel, businessId])
}

model BlizzwayStarterPathway {
  id              String   @id @default(cuid())
  businessModel   String   @default("blizzway")
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  milestones      Json     @default("[]")
  xp              Int      @default(0)
  level           Int      @default(1)
  progress        Int      @default(10)
  achievementHooks Json    @default("[]")
  source          String   @default("nexa_onboarding_v1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessModel, businessId, userId])
  @@index([businessModel, businessId])
}

model Career7CreditWallet {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId])
}

model Career7CreditLedger {
  id              String   @id @default(cuid())
  businessModel   String   @default("career7")
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String?
  type            Career7CreditLedgerType
  amount          Int
  balanceAfter    Int
  agentId         String?
  growthBoardItemId String?
  source          String?
  idempotencyKey  String?
  description     String
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  @@unique([idempotencyKey])
  @@index([businessModel, businessId, userId])
  @@index([source])
  @@index([agentId])
  @@index([createdAt])
}

model BlizzwayCompanionActivation {
  id            String   @id @default(cuid())
  businessModel String   @default("blizzway")
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId   String
  companion     MarketplaceAgent @relation(fields: [companionId], references: [id], onDelete: Cascade)
  attachedTo    String   @default("pathway")
  status        String   @default("ACTIVE")
  activatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessModel, businessId, userId, companionId])
  @@index([businessModel, businessId, userId, status])
  @@index([companionId])
}

model BlizzwayCompanionRun {
  id              String   @id @default(cuid())
  businessModel   String   @default("blizzway")
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId     String
  companion       MarketplaceAgent @relation(fields: [companionId], references: [id], onDelete: Cascade)
  activationId    String?
  input           Json     @default("{}")
  output          Json     @default("{}")
  creditsCharged  Int      @default(0)
  ledgerId        String?
  idempotencyKey  String?  @unique
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())

  @@index([businessModel, businessId, userId])
  @@index([companionId])
  @@index([createdAt])
}

model BlizzwayCompanionRequest {
  id              String   @id @default(cuid())
  businessModel   String   @default("blizzway")
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  category        String
  description     String
  expectedOutput  String?
  status          String   @default("PENDING")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessModel, businessId, userId])
  @@index([status])
}

model BlizzwayPathwayQuest {
  id             String   @id @default(cuid())
  businessModel  String   @default("blizzway")
  key            String
  title          String
  description    String
  level          Int      @default(1)
  xpReward       Int      @default(0)
  achievementKey String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([businessModel, key])
  @@index([businessModel, active, sortOrder])
}

model BlizzwayAchievement {
  id            String   @id @default(cuid())
  businessModel String   @default("blizzway")
  key           String
  title         String
  description   String
  category      String   @default("Pathway")
  icon          String   @default("Star")
  rewardCredits Int      @default(0)
  xpReward      Int      @default(0)
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessModel, key])
  @@index([businessModel, active, sortOrder])
}

model BlizzwayUserQuest {
  id             String   @id @default(cuid())
  businessModel  String   @default("blizzway")
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questKey       String
  status         String   @default("COMPLETED")
  xpAwarded      Int      @default(0)
  completedAt    DateTime @default(now())
  idempotencyKey String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([businessModel, businessId, userId, questKey])
  @@unique([idempotencyKey])
  @@index([businessModel, businessId, userId, status])
}

model BlizzwayUserAchievement {
  id             String   @id @default(cuid())
  businessModel  String   @default("blizzway")
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String
