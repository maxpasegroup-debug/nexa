  raiser      User     @relation("ClarificationRaiser", fields: [raisedBy], references: [id])
  question    String   @db.Text
  context     String?
  answeredBy  String?
  answerer    User?    @relation("ClarificationAnswerer", fields: [answeredBy], references: [id])
  answer      String?  @db.Text
  status      String   @default("pending")
  notifiedAt  DateTime?
  answeredAt  DateTime?
  createdAt   DateTime @default(now())
}

model WorkspaceTemplate {
  id           String   @id @default(cuid())
  name         String
  industry     String
  description  String
  config       Json
  usageCount   Int      @default(0)
  createdFrom  String?
  isPublic     Boolean  @default(false)
  createdBy    String
  creator      User     @relation(fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamInvite {
  id         String   @id @default(cuid())
  email      String
  name       String
  role       Role     @default(BDM)
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  token      String   @unique @default(cuid())
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())
}

model BossWorkLock {
  id             String    @id @default(cuid())
  businessId     String
  targetType     String
  targetId       String
  targetRole     Role
  targetUserId   String?
  status         String    @default("ACTIVE")
  message        String
  startedBy      String
  starter        User      @relation("BossLockCreator", fields: [startedBy], references: [id])
  finishedBy     String?
  finisher       User?     @relation("BossLockFinisher", fields: [finishedBy], references: [id])
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId, targetRole, status])
  @@index([targetType, targetId, status])
}

model NexaMessage {
  id         String   @id @default(cuid())
  businessId String
  role       String
  content    String
  createdAt  DateTime @default(now())
}

model DailyBrief {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @default(now())
  tasks      Json
  insights   Json
  greeting   String
  createdAt  DateTime @default(now())
}

model CallLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  leadId     String
  lead       Lead        @relation(fields: [leadId], references: [id])
  outcome    CallOutcome
  duration   Int?
  notes      String?
  nextAction String?
  createdAt  DateTime    @default(now())
}

enum CallOutcome {
  ANSWERED_INTERESTED
  ANSWERED_NOT_INTERESTED
  ANSWERED_CALLBACK
  NO_ANSWER
  BUSY
  WRONG_NUMBER
}

model Target {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  month         Int
  year          Int
  leadsTarget   Int      @default(0)
  wonTarget     Int      @default(0)
  revenueTarget Float    @default(0)
  fixedSalary   Float    @default(0)
  maxIncentive  Float    @default(30000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, month, year])
}

model Sprint {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id])
  name        String
  goal        String?
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus @default(PLANNING)
  tasks       Task[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Bug {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id])
  title        String
  description  String
  severity     Severity  @default(MEDIUM)
  status       BugStatus @default(OPEN)
  reportedBy   String
  reporter     User      @relation("BugReporter", fields: [reportedBy], references: [id])
  assignedTo   String?
  assignee     User?     @relation("BugAssignee", fields: [assignedTo], references: [id])
  stepsToRepro String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  WONT_FIX
}

model Escalation {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id])
  type         EscalationType
  title        String
  description  String
  priority     Priority
  status       EscalationStatus @default(OPEN)
  raisedBy     String
  raiser       User             @relation("EscalationRaiser", fields: [raisedBy], references: [id])
  resolvedBy   String?
  resolver     User?            @relation("EscalationResolver", fields: [resolvedBy], references: [id])
  resolution   String?
  resolvedAt   DateTime?
  notifiedDev  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

enum EscalationType {
  BUG
  INTEGRATION
  FEATURE_REQUEST
  SECURITY
  PERFORMANCE
  OTHER
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model IntegrationHealth {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  type         String
  status       String   @default("unknown")
  lastChecked  DateTime @default(now())
  lastError    String?
  responseTime Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NexaMemory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  key        String
  value      Json
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, key])
}

model NexaSchedule {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  type        String
  cronExpr    String
  lastRanAt   DateTime?
  nextRunAt   DateTime
  enabled     Boolean  @default(true)
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessSnapshot {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id])
  date             DateTime @default(now())
  healthScore      Int
  totalLeads       Int
  newLeads         Int
  wonLeads         Int
  lostLeads        Int
  totalRevenue     Float
  teamActivity     Int
  openTasks        Int
  openBugs         Int
  nexaActionsCount Int
  createdAt        DateTime @default(now())
}

model NexaAction {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  type        String
  description String
  payload     Json     @default("{}")
  status      String   @default("completed")
  triggeredBy String   @default("nexa")
  createdAt   DateTime @default(now())
}

model UniverseUser {
  id           String             @id @default(cuid())
  name         String
  phone        String             @unique
  pinHash      String
  language     String             @default("ml")
  referralCode String             @unique @default(cuid())
  referredBy   String?
  createdAt    DateTime           @default(now())
  progress     UniverseProgress[]
}

model UniverseProgress {
  id          String       @id @default(cuid())
  userId      String
  user        UniverseUser @relation(fields: [userId], references: [id])
  stepNumber  Int
  completedAt DateTime     @default(now())

  @@unique([userId, stepNumber])
}
