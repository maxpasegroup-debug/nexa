{
  "name": "7universe-railway-root",
  "private": true,
  "scripts": {
    "install": "npm ci --prefix 7universe-frontend",
    "postinstall": "prisma generate --schema ./BGOS/prisma/schema.prisma",
    "build": "prisma generate --schema ./BGOS/prisma/schema.prisma && npm run build --prefix 7universe-frontend",
    "start": "npm run start --prefix 7universe-frontend -- -p $PORT"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
